{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "strictNullChecks": true,
    "noImplicitAny": true
  },
  "include": [],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.smoke.test.ts",
    "src/**/*.smoke.test.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ],
  "files": [
    "src/vite-env.d.ts",
    "src/store/slices/chatSlice.ts",
    "src/store/slices/usersSlice.ts",
    "src/constants/index.ts",
    "src/domain/permissions.ts",
    "src/config/runtimeMode.ts",
    "src/services/providers/ServiceContracts.ts",
    "src/ui/AppIcon.tsx",
    "src/ui/AvatarCircle.tsx",
    "src/ui/PhotoLightbox.tsx",
    "src/ui/Toasts.tsx",
    "src/ui/ConfirmDialog.tsx",
    "src/chat/hooks/useChatSearch.ts",
    "src/chat/hooks/useChatComposer.ts",
    "src/chat/hooks/useChatData.ts",
    "src/chat/ChatMessageList.tsx",
    "src/chat/ChatView.tsx"
  ]
}
