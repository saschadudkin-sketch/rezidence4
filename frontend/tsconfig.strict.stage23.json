{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "strictNullChecks": true,
    "noImplicitAny": true
  },
  "include": [],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.smoke.test.ts",
    "src/**/*.smoke.test.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ],
  "files": [
    "src/vite-env.d.ts",
    "src/types/qrcode.d.ts",
    "src/store/slices/chatSlice.ts",
    "src/store/slices/requestsSlice.ts",
    "src/store/slices/blacklistSlice.ts",
    "src/store/slices/usersSlice.ts",
    "src/store/slices/permsSlice.ts",
    "src/store/slices/garageSlice.ts",
    "src/domain/permissions.ts",
    "src/domain/navigation.ts",
    "src/domain/roleResponsibilities.ts",
    "src/domain/navigationSchema.ts",
    "src/domain/navigationRules.ts",
    "src/domain/roleManifest.ts",
    "src/data/dataPlanePolicy.ts",
    "src/services/http/errorTaxonomy.ts",
    "src/config/runtimeMode.ts",
    "src/constants/limits.ts",
    "src/utils/phoneUtils.ts",
    "src/utils/loginMetrics.ts",
    "src/utils/index.ts",
    "src/ui/errorPresenter.ts",
    "src/ui/ErrorRecoveryPanel.tsx",
    "src/ui/Toasts.tsx",
    "src/hooks/useOnlineStatus.ts",
    "src/hooks/useAuthFlow.ts",
    "src/hooks/useAuth.ts",
    "src/store/persistence/storageRegistry.ts",
    "src/store/persistence/localStorage.ts",
    "src/store/AppStore.tsx",
    "src/views/Login.tsx",
    "src/App.tsx"
  ]
}
