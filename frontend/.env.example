# Residenze — переменные окружения
# Скопируйте в .env.local и заполните значениями

# Режим работы: 'demo' | 'live'
VITE_RUNTIME_MODE=demo

# URL backend API (Timeweb VPS)
VITE_API_URL=https://api.your-domain.ru

# URL backend для CSP-заголовка nginx (должен совпадать с VITE_API_URL)
BACKEND_URL=https://api.your-domain.ru
