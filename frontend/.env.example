# Residenze — переменные окружения
# Скопируйте в .env.local и заполните значениями
# Важно: используются только VITE_* переменные (legacy REACT_APP_* не поддерживается).

# Production user journey: only live.
# Demo sandbox включайте только на internal/staging стендах.
VITE_RUNTIME_MODE=live
VITE_ENABLE_DEMO=false

# URL backend API (Timeweb VPS)
VITE_API_URL=https://api.your-domain.ru

# URL backend для CSP-заголовка nginx (должен совпадать с VITE_API_URL)
BACKEND_URL=https://api.your-domain.ru
VITE_SENTRY_DSN=
VITE_APP_VERSION=local-dev
