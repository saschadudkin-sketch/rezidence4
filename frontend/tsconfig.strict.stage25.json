{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "strictNullChecks": true,
    "noImplicitAny": true
  },
  "include": [],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.smoke.test.ts",
    "src/**/*.smoke.test.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ],
  "files": [
    "src/vite-env.d.ts",
    "src/types/qrcode.d.ts",
    "src/store/slices/chatSlice.ts",
    "src/store/slices/requestsSlice.ts",
    "src/store/slices/blacklistSlice.ts",
    "src/store/slices/usersSlice.ts",
    "src/store/slices/permsSlice.ts",
    "src/store/slices/garageSlice.ts",
    "src/domain/requestWorkflow.ts",
    "src/domain/permissions.ts",
    "src/services/logger.ts",
    "src/services/http/errorTaxonomy.ts",
    "src/services/providers/serviceDtos.ts",
    "src/services/providers/ServiceContracts.ts",
    "src/utils/telemetryContract.ts",
    "src/config/runtimeMode.ts",
    "src/constants/syncStatuses.ts",
    "src/utils/swUtils.ts",
    "src/utils/events.ts",
    "src/utils/notifUtils.ts",
    "src/ui/Toasts.tsx",
    "src/ui/syncFeedback.ts",
    "src/store/useDebouncedSave.ts",
    "src/store/storeActions.ts",
    "src/store/actionDomains.ts",
    "src/store/boundedContexts/contexts.ts",
    "src/store/boundedContexts/domainRegistry.ts",
    "src/store/boundedContexts/useStoreActions.ts",
    "src/store/boundedContexts/useDomainStates.ts",
    "src/store/persistence/mediaStore.ts",
    "src/store/persistence/storageRegistry.ts",
    "src/store/persistence/localStorage.ts",
    "src/store/AppStore.tsx",
    "src/hooks/useOnlineStatus.ts",
    "src/hooks/useAuth.ts",
    "src/App.tsx"
  ]
}
