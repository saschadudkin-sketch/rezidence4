{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "strictNullChecks": true,
    "noImplicitAny": true
  },
  "include": [],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.smoke.test.ts",
    "src/**/*.smoke.test.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ],
  "files": [
    "src/vite-env.d.ts",
    "src/store/slices/requestsSlice.ts",
    "src/store/slices/usersSlice.ts",
    "src/constants/index.ts",
    "src/constants/statusPresentation.ts",
    "src/constants/limits.ts",
    "src/constants/requestPredicates.ts",
    "src/hooks/useDebounce.ts",
    "src/hooks/useVisitLogs.ts",
    "src/services/providers/ServiceContracts.ts",
    "src/shared/api/passesApi.ts",
    "src/ui/Toasts.tsx",
    "src/ui/errorPresenter.ts",
    "src/ui/AppIcon.tsx",
    "src/ui/viewStateContract.ts",
    "src/domain/permissions.ts",
    "src/views/VisitLogView.tsx"
  ]
}
