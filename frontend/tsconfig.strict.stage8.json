{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "strictNullChecks": true,
    "noImplicitAny": true
  },
  "include": [],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.smoke.test.ts",
    "src/**/*.smoke.test.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ],
  "files": [
    "src/vite-env.d.ts",
    "src/types/qrcode.d.ts",
    "src/store/slices/requestsSlice.ts",
    "src/store/slices/chatSlice.ts",
    "src/store/slices/usersSlice.ts",
    "src/store/slices/permsSlice.ts",
    "src/store/slices/blacklistSlice.ts",
    "src/store/slices/garageSlice.ts",
    "src/domain/permissions.ts",
    "src/domain/passLifecycle.ts",
    "src/constants/index.ts",
    "src/constants/syncStatuses.ts",
    "src/constants/requestPredicates.ts",
    "src/constants/statusPresentation.ts",
    "src/constants/limits.ts",
    "src/hooks/useDebounce.ts",
    "src/hooks/useLiveSync.ts",
    "src/hooks/useIsMounted.ts",
    "src/services/logger.ts",
    "src/services/http/authSession.ts",
    "src/services/http/retryPolicy.ts",
    "src/services/http/transport.ts",
    "src/services/http/uploadClient.ts",
    "src/services/providers/backendProvider.ts",
    "src/services/qrService.ts",
    "src/store/boundedContexts/useDomainStates.ts",
    "src/store/persistence/localStorage.ts",
    "src/ui/Toasts.tsx",
    "src/ui/VirtualList.tsx",
    "src/ui/syncFeedback.ts",
    "src/ui/AppIcon.tsx",
    "src/ui/AvatarCircle.tsx",
    "src/ui/PhotoLightbox.tsx",
    "src/ui/useModalAccessibility.ts",
    "src/requests/PassQRModal.tsx",
    "src/requests/ReqCard.tsx",
    "src/requests/GroupedReqList.tsx",
    "src/views/admin/AdminUserRow.tsx",
    "src/views/admin/AdminReqRow.tsx",
    "src/views/admin/AdminPermsView.tsx",
    "src/services/pushNotification.ts",
    "src/shared/api/passesApi.ts",
    "src/views/guard/GuardCard.tsx",
    "src/views/guard/TechCard.tsx",
    "src/views/guard/TempPassCard.tsx",
    "src/views/guard/GuardSection.tsx"
  ]
}
