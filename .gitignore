# dependencies
node_modules/
**/node_modules/

# build artifacts
build/
dist/
**/dist/
frontend/build/
frontend/storybook-static/
coverage/
**/coverage/
__pycache__/
**/__pycache__/
*.pyc

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env
.env.*
!.env.example

# OS/editor
.DS_Store
.idea/
.vscode/
.vs/

# Playwright visual artifacts (binary snapshots are not supported in this environment)
e2e/**/*.png
e2e/**/visual-states.spec.js-snapshots/
playwright-report/
.playwright-cli/
frontend/.playwright-cli/
frontend/.vite*
frontend/vitest*.log
frontend/.codex-eslint.log
artifacts/

# Claude Code internals
# Project-level shared config IS committed: .claude/settings.json,
# .claude/agents/, .claude/commands/, .claude/launch.json, .mcp.json.
# Локальные / runtime артефакты — игнорируем:
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/projects/
.claude/.credentials.json
.claude/statsig/
.claude/todos/
.claude/memory/
.claude/shell-snapshots/

# Dev/test artifacts
output/
frontend/output/
test-results/
frontend/test-results/
frontend/playwright-report/
pw-web*.log
frontend/pw-web*.log
frontend/dev-server.log
frontend/dev-server.err.log
frontend/lint-current.log
frontend/vite*.log
