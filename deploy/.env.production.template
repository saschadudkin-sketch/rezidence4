# ─────────────────────────────────────────────────────────────────────────────
# DomHub — Production .env Template
# ─────────────────────────────────────────────────────────────────────────────
#
# Скопируй как .env в корень проекта на VPS:
#   cp deploy/.env.production.template .env
#   chmod 600 .env
#
# Затем сгенерируй secrets через `openssl rand -hex 32` и заполни placeholders.
#
# ⚠️  НЕ коммитить заполненный .env в git!
# ⚠️  НЕ путать с ops/ci-dummy.env — то CI-only fake creds.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Database / Redis credentials ─────────────────────────────────────────────
# Сгенерировать: openssl rand -hex 24 (24 bytes = 48 hex chars)
DB_PASSWORD=__GENERATE_openssl_rand_hex_24__
REDIS_PASSWORD=__GENERATE_openssl_rand_hex_24__

# ── JWT Secrets (≥32 chars каждый, разные между собой) ──────────────────────
# Сгенерировать: openssl rand -hex 32
# Если совпадают → резидентский токен пройдёт jwt.verify на /platform/* (security audit #3).
JWT_SECRET=__GENERATE_openssl_rand_hex_32__
PLATFORM_JWT_SECRET=__GENERATE_openssl_rand_hex_32__

# ── Upload signing secret (≥32 chars) ────────────────────────────────────────
# Подписывает upload URLs. Сгенерировать: openssl rand -hex 32.
UPLOAD_SIGNING_SECRET=__GENERATE_openssl_rand_hex_32__

# ── Public-facing URLs ───────────────────────────────────────────────────────
# Точный URL без trailing slash. Используется для CORS allow-list.
YOUR_DOMAIN=domhub.app
FRONTEND_URL=https://domhub.app
BACKEND_URL=https://domhub.app

# ── HTTPS toggle (для frontend nginx) ────────────────────────────────────────
ENABLE_HTTPS=true

# ── NODE_ENV (обязательно "production" для prod) ─────────────────────────────
NODE_ENV=production

# ── SMS provider (sms.ru) ────────────────────────────────────────────────────
# STUB = в логи, без real send. Для prod заменить на реальный API ID.
# Получить: https://sms.ru → API → API ID
SMSRU_API_ID=__REAL_SMSRU_API_ID__

# ── Web Push (VAPID keys) ────────────────────────────────────────────────────
# Сгенерировать: npx web-push generate-vapid-keys
# (требует web-push установленным; либо http://web-push-codelab.glitch.me)
VAPID_PUBLIC_KEY=__VAPID_PUBLIC__
VAPID_PRIVATE_KEY=__VAPID_PRIVATE__
VAPID_SUBJECT=mailto:admin@domhub.app

# ── Sentry (если используется) ───────────────────────────────────────────────
# Создать проект: https://sentry.io → New Project → Node.js
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=v1.0.0

# ── PostgreSQL SSL ───────────────────────────────────────────────────────────
# В prod backend проверяет sslmode=require/verify-ca/verify-full.
# Внутри docker-network postgres communication уже изолирован, но если
# подключаетесь к external managed DB (RDS/Cloud SQL/etc), нужно sslmode.
#
# Для embedded postgres (docker-compose) можно отключить:
# PG_SSL_REQUIRED=0
#
# Для external DB:
# PG_SSL_REQUIRED=1   (или просто не задавать — default)
# DATABASE_URL=postgresql://user:pwd@db.host/residenze?sslmode=require

# ── Multi-tenant DSN'ы (если разные DB) ──────────────────────────────────────
# По умолчанию docker-compose собирает их из DB_PASSWORD автоматически.
# Раскомментировать только если platform/zamoskv на отдельном сервере:
# PLATFORM_DB_URL=postgresql://user:pwd@platform.host/platform?sslmode=require
# ZAMOSKV_DB_URL=postgresql://user:pwd@zamoskv.host/zamoskv?sslmode=require

# ── Trust proxy (если за reverse-proxy nginx/caddy/cloudflare) ───────────────
# Количество hops до nginx. По умолчанию 1 (frontend nginx → backend).
# TRUST_PROXY_HOPS=1

# ── Refresh token legacy fallback ────────────────────────────────────────────
# В prod должен быть выключен. Включается только на migration window.
REFRESH_LEGACY_FALLBACK_ENABLED=0

# ── Notifications outbox (если фоновый worker нужен) ─────────────────────────
# NOTIFICATIONS_OUTBOX_ENABLED=1
# NOTIFICATIONS_OUTBOX_RETENTION_BATCH=500

# ── SSE (server-sent events) limits ──────────────────────────────────────────
# SSE_MAX_CONNECTIONS=1000

# ── Contact email (отображается на error pages) ──────────────────────────────
# CONTACT_EMAIL=support@domhub.app

# ── Backup target (если используется external storage) ──────────────────────
# BACKUP_DATABASES="residenze platform zamoskv"   # default
# BACKUP_S3_BUCKET=domhub-backups                  # если S3
