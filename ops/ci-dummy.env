# CI-only dummy values для docker-compose interpolation в GitHub Actions.
#
# docker-compose.yml объявляет несколько required env-переменных
# (sslmode/JWT_SECRET/PLATFORM_JWT_SECRET/...), без которых `docker compose
# build` или `up` падает на YAML-interpolation до запуска контейнеров.
#
# В CI:
#   - docker-build job — НЕ поднимает контейнеры; values эти не используются
#     (compose только парсит YAML).
#   - e2e-test / nightly-smoke jobs — поднимают полный stack, эти values
#     становятся реальными (но scope = ephemeral CI run).
#
# **НЕ для production.**  Production config — в .env (не checked in) или
# через secrets manager (Doppler/Vault/etc).
#
# Все секреты сгенерированы один раз для CI:
#   openssl rand -hex 32
# Ротировать НЕ нужно — они не дают доступ ни к чему реальному.

DB_PASSWORD=ci-dummy-db-pwd
REDIS_PASSWORD=ci-dummy-redis-pwd

# JWT_SECRET и PLATFORM_JWT_SECRET должны быть ≥32 символов и разные
# (см. backend/src/config/appConfig.js validateConfig).
JWT_SECRET=ci-dummy-jwt-secret-32chars-padding-ok
PLATFORM_JWT_SECRET=ci-dummy-platform-jwt-different-pad

UPLOAD_SIGNING_SECRET=ci-dummy-upload-signing-secret-pad

# Эти URL используются только если backend стартует и применяет CORS / cookie
# domain.  В docker-build не используются.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Frontend nginx (services.frontend) требует YOUR_DOMAIN для server_name.
# В CI используется loopback domain.
YOUR_DOMAIN=ci.local
ENABLE_HTTPS=false

# Опциональные с дефолтами в compose — переопределяем чтобы не было
# warning'ов в CI логах.
SMSRU_API_ID=STUB
NODE_ENV=test
