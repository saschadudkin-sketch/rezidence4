# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://residenze:STRONG_PASSWORD@db:5432/residenze

# ── Auth ──────────────────────────────────────────────────────────────────────
# Random secret for JWT signing — generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_32_CHARS

# Migration flag: allow legacy refresh lookup by raw token id.
# SAFE DEFAULT: keep 0.
# Temporarily set to 1 only during short migration window
# for legacy refresh tokens, then switch back to 0.
REFRESH_LEGACY_FALLBACK_ENABLED=0

# ── SMS.ru ────────────────────────────────────────────────────────────────────
# Get your API ID at https://sms.ru → Настройки → API
# Leave as STUB to print codes to server logs (for testing)
SMSRU_API_ID=STUB
SENTRY_DSN=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# URL of this backend — used for photo URLs in responses
BACKEND_URL=http://YOUR_SERVER_IP:3001

# Allowed frontend origins (comma-separated, explicit origins only)
FRONTEND_URL=http://YOUR_SERVER_IP

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Enables: SSE pub/sub (horizontal scaling), idempotency cache (cluster-safe)
# Leave empty for single-instance mode (in-memory fallback)
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379

# ── SSE (Server-Sent Events) ──────────────────────────────────────────────────
# DO-03: Maximum concurrent SSE connections per server instance.
# Each open /api/sse endpoint holds one Node.js socket + one Redis subscriber.
# With 100 residents and a typical reconnect rate, ~150 is safe for a 1-core VPS.
# Increase for larger deployments; use horizontal scaling (Redis pub/sub) above 500.
# Default: 200. Set to 0 to disable the per-instance limit (not recommended).
SSE_MAX_CONNECTIONS=200

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# Secret for signing upload access URLs — ОТДЕЛЬНЫЙ от JWT_SECRET.
# Обязателен в production (сервер не запустится без него).
# Сгенерировать: openssl rand -hex 32
UPLOAD_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET_32_CHARS

# Signed URL TTL (seconds). Default: 300 (5 min). Min: 30.
UPLOAD_SIGNED_URL_TTL_SECONDS=300

# ── SMS Fallback Provider (optional) ─────────────────────────────────────────
# Secondary SMS provider key — used automatically if primary sms.ru fails.
# Same sms.ru endpoint, different account; or swap for another provider in smsService.js.
# Leave empty to disable fallback (SMS send will fail if primary is down).
SMSRU_FALLBACK_API_ID=

# REFRESH_LEGACY_FALLBACK deadline — auto-disables legacy token lookup after this date.
# Format: ISO 8601 (YYYY-MM-DD). Default: 2026-01-01.
REFRESH_LEGACY_DEADLINE=2026-01-01

# ── Database Connection Pooling ───────────────────────────────────────────────
# For horizontal scaling (2+ backend instances), use PgBouncer between Node.js
# and PostgreSQL to limit total DB connections.
# Without PgBouncer: N_instances × pool_size connections hit PostgreSQL directly.
# With PgBouncer:    shared pool regardless of backend instance count.
#
# To enable: set DATABASE_URL to point to PgBouncer, not PostgreSQL directly.
# Example:   DATABASE_URL=postgres://user:pass@pgbouncer:5432/residenze
# PgBouncer mode: transaction (recommended for Node.js — avoids prepared statement issues)
# See: https://www.pgbouncer.org/config.html
