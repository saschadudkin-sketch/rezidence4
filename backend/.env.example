# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://residenze:STRONG_PASSWORD@db:5432/residenze

# ── Auth ──────────────────────────────────────────────────────────────────────
# Random secret for JWT signing — generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_32_CHARS

# Migration flag: allow legacy refresh lookup by raw token id.
# SAFE DEFAULT: keep 0.
# Temporarily set to 1 only during short migration window
# for legacy refresh tokens, then switch back to 0.
REFRESH_LEGACY_FALLBACK_ENABLED=0

# ── SMS.ru ────────────────────────────────────────────────────────────────────
# Get your API ID at https://sms.ru → Настройки → API
# Leave as STUB to print codes to server logs (for testing)
SMSRU_API_ID=STUB

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# URL of this backend — used for photo URLs in responses
BACKEND_URL=http://YOUR_SERVER_IP:3001

# Allowed frontend origins (comma-separated, explicit origins only)
FRONTEND_URL=http://YOUR_SERVER_IP

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Enables: SSE pub/sub (horizontal scaling), idempotency cache (cluster-safe)
# Leave empty for single-instance mode (in-memory fallback)
REDIS_URL=redis://redis:6379

# ── SSE (Server-Sent Events) ──────────────────────────────────────────────────
# DO-03: Maximum concurrent SSE connections per server instance.
# Each open /api/sse endpoint holds one Node.js socket + one Redis subscriber.
# With 100 residents and a typical reconnect rate, ~150 is safe for a 1-core VPS.
# Increase for larger deployments; use horizontal scaling (Redis pub/sub) above 500.
# Default: 200. Set to 0 to disable the per-instance limit (not recommended).
SSE_MAX_CONNECTIONS=200

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
