{
  "name": "rezidence4",
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "openapi-typescript": "^7.13.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.cjs",
    "install:all": "node scripts/bootstrap.cjs",
    "dev": "node scripts/dev.js",
    "dev:backend": "node scripts/run-npm.cjs --prefix backend run dev",
    "dev:frontend": "node scripts/run-npm.cjs --prefix frontend run dev",
    "test": "node scripts/run-checks.cjs test",
    "backend:test": "node scripts/run-npm.cjs --prefix backend run test:ci",
    "lint": "node scripts/run-frontend-script.cjs lint",
    "frontend:lint": "node scripts/run-frontend-script.cjs lint",
    "typecheck": "node scripts/run-frontend-script.cjs typecheck:ci",
    "frontend:typecheck": "node scripts/run-frontend-script.cjs typecheck:ci",
    "frontend:test": "node scripts/run-frontend-script.cjs test",
    "build": "node scripts/run-frontend-script.cjs build",
    "frontend:build": "node scripts/run-frontend-script.cjs build",
    "verify": "node scripts/run-checks.cjs verify",
    "verify:strict": "node scripts/run-strict-verify.cjs",
    "release:gate:matrix": "node scripts/release-gate-matrix.cjs --list",
    "release:gate:metadata": "node scripts/release-gate-matrix.cjs --metadata",
    "release:gate:check": "node scripts/release-gate-matrix.cjs --require-runtime-evidence",
    "pilot:training-pack": "node scripts/pilot-training-pack-check.cjs",
    "pilot:readiness": "node scripts/pilot-readiness-check.cjs",
    "russia:readiness": "node scripts/russia-readiness-check.cjs",
    "e2e": "node scripts/run-playwright-tests.cjs",
    "test:e2e:v1-access": "node scripts/run-v1-access-e2e.cjs",
    "test:e2e:preflight": "node scripts/playwright-preflight.cjs",
    "tenant:preflight": "node scripts/tenant-ops-preflight.cjs",
    "tenant:preflight:local": "node scripts/tenant-ops-preflight.cjs --e2e-access --require-current-migrations",
    "tenant:preflight:e2e": "node scripts/tenant-ops-preflight.cjs --e2e-access",
    "tenant:preflight:current": "node scripts/tenant-ops-preflight.cjs --require-current-migrations",
    "tenant:provision": "node scripts/tenant-ops-provision.cjs",
    "tenant:migrate": "node scripts/tenant-ops-migrate.cjs",
    "tenant:restore-drill:preflight": "node scripts/restore-drill-preflight.cjs",
    "tenant:restore-drill": "node scripts/restore-drill-preflight.cjs && node scripts/restore-drill.cjs",
    "test:e2e": "node scripts/run-playwright-tests.cjs",
    "test:e2e:visual": "node ./node_modules/@playwright/test/cli.js test e2e/visual-states.spec.js",
    "openapi:types": "openapi-typescript docs/openapi.json -o frontend/src/api/generated/openapi.d.ts",
    "openapi:drift": "node scripts/openapi-v1-drift-gate.cjs",
    "security:gitleaks": "node scripts/run-gitleaks.cjs",
    "security:semgrep": "node scripts/run-semgrep.cjs",
    "security:scan": "npm run security:gitleaks && npm run security:semgrep"
  },
  "version": "1.0.0",
  "description": "Multi-tenant residential complex management platform. Each complex gets its own PostgreSQL database; a central Registry DB maps subdomains to connection strings.",
  "main": "playwright.config.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "@21st-sdk/agent": "^0.0.16",
    "core-util-is": "^1.0.3",
    "detect-libc": "^2.1.2",
    "https": "^1.0.0",
    "image-size": "^1.2.1",
    "immediate": "^3.0.6",
    "inherits": "^2.0.4",
    "isarray": "^1.0.0",
    "jszip": "^3.10.1",
    "lie": "^3.3.0",
    "pako": "^1.0.11",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "pptxgenjs": "^4.0.1",
    "process-nextick-args": "^2.0.1",
    "queue": "^6.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "readable-stream": "^2.3.8",
    "safe-buffer": "^5.1.2",
    "scheduler": "^0.27.0",
    "semver": "^7.7.4",
    "setimmediate": "^1.0.5",
    "sharp": "^0.34.5",
    "string_decoder": "^1.1.1",
    "undici-types": "^6.21.0",
    "util-deprecate": "^1.0.2",
    "zod": "^4.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saschadudkin-sketch/rezidence4.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/saschadudkin-sketch/rezidence4/issues"
  },
  "homepage": "https://github.com/saschadudkin-sketch/rezidence4#readme"
}
