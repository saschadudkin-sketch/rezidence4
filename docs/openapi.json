  "components": {
    "schemas": {
      "OkResponse": {
        "type": "object",
        "required": ["ok"],
        "properties": { "ok": { "type": "boolean" } },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } },
        "additionalProperties": true
      },
      "ConflictResponse": {
        "type": "object",
        "required": ["error", "code"],
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" },
          "details": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": true
      },
      "StatusTransitionsResponse": {
        "type": "object",
        "required": ["roles", "version"],
        "properties": {
          "version": { "type": "integer" },
          "roles": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["from", "to"],
                  "properties": {
                    "from": { "type": "array", "items": { "type": "string" } },
                    "to": { "type": "array", "items": { "type": "string" } }
                  }
                }
              ]
            }
          }
        }
      },
      "User": {
        "type": "object",
        "required": ["uid", "phone", "name", "role"],
        "properties": {
          "uid": { "type": "string" },
          "phone": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" }
        }
      },
      "AuthRefreshSuccess": {
        "type": "object",
        "required": ["user"],
        "properties": { "user": { "$ref": "#/components/schemas/User" } }
      },
      "RequestItem": { "type": "object" },
      "RequestsListResponse": {
        "oneOf": [
          { "type": "array", "items": { "$ref": "#/components/schemas/RequestItem" } },
          {
            "type": "object",
            "required": ["data", "total", "page", "limit"],
            "properties": {
              "data": { "type": "array", "items": { "$ref": "#/components/schemas/RequestItem" } },
              "total": { "type": "integer" },
              "page": { "type": "integer" },
              "limit": { "type": "integer" }
            }
          }
        ]
      },
      "UploadResponse": {
        "type": "object",
        "required": ["url"],
        "properties": { "url": { "type": "string" } }
      },
      "ChatMessage": { "type": "object" },
      "ChatMessagesResponse": {
        "type": "object",
        "required": ["messages", "hasMore"],
        "properties": {
          "messages": { "type": "array", "items": { "$ref": "#/components/schemas/ChatMessage" } },
          "hasMore": { "type": "boolean" }
        }
      },
      "Pass": {
        "type": "object",
        "required": ["id", "property_id", "pass_type", "subject_type", "status", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "property_id": { "type": "string", "format": "uuid" },
          "access_request_id": { "type": "string", "format": "uuid", "nullable": true },
          "pass_type": { "type": "string", "enum": ["guest", "vehicle", "resident", "staff", "contractor", "courier", "service", "emergency"] },
          "subject_type": { "type": "string", "enum": ["resident", "staff", "contractor_user", "vehicle", "guest"] },
          "subject_resident_id": { "type": "string", "nullable": true },
