# Скопируйте в .env и заполните:
#   cp .env.example .env && nano .env

# ── Пароль базы данных ────────────────────────────────────────────────────────
# Придумайте любой сложный пароль (только буквы и цифры, без спецсимволов)
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Секрет для JWT-токенов ────────────────────────────────────────────────────
# Сгенерируйте случайную строку:  openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_32_CHAR_RANDOM_SECRET

# ── Пароль Redis ──────────────────────────────────────────────────────────────
# FIX [AUDIT]: Redis теперь требует аутентификации.
# Без пароля любой процесс в docker-сети может читать кеш отозванных токенов.
# Сгенерируйте: openssl rand -hex 24
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ── SMS.ru API ────────────────────────────────────────────────────────────────
# Зарегистрируйтесь на https://sms.ru, скопируйте API ID из настроек
# Пока не готово — оставьте STUB (коды будут видны в логах: docker compose logs backend)
SMSRU_API_ID=STUB
SENTRY_DSN=

# ── URL адреса ────────────────────────────────────────────────────────────────
# IP вашего сервера на Timeweb (или домен если есть)
BACKEND_URL=http://YOUR_SERVER_IP
FRONTEND_URL=http://YOUR_SERVER_IP

# ── Домен для nginx HTTPS конфига ─────────────────────────────────────────────
# FIX [AUDIT]: используется envsubst для подстановки в nginx CSP-заголовок.
# При HTTP: можно оставить IP сервера.
# При HTTPS: укажите реальный домен (например: residenze.yourdomain.com).
YOUR_DOMAIN=YOUR_SERVER_IP_OR_DOMAIN

# Set to true only after HTTPS certificates are issued and port 443 is enabled in docker-compose.yml.
ENABLE_HTTPS=false
