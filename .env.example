# Скопируйте в .env и заполните:
#   cp .env.example .env && nano .env

# ── Пароль базы данных ────────────────────────────────────────────────────────
# Придумайте любой сложный пароль (только буквы и цифры, без спецсимволов)
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Секрет для JWT-токенов ────────────────────────────────────────────────────
# Сгенерируйте случайную строку:  openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_32_CHAR_RANDOM_SECRET

# ── Platform Database (Multi-tenant Registry) ────────────────────────────────
# Отдельная база данных для реестра всех жилых комплексов
# PostgreSQL connection string для платформенной БД
PLATFORM_DB_URL=postgresql://user:pass@localhost:5432/domhub_platform

# ── Platform JWT Secret ──────────────────────────────────────────────────────
# Отдельный секрет для JWT-токенов платформенных администраторов
# Должен отличаться от основного JWT_SECRET для безопасности
PLATFORM_JWT_SECRET=REPLACE_WITH_DIFFERENT_32_CHAR_SECRET

# ── Property Database URLs ───────────────────────────────────────────────────
# URL базы данных для конкретного жилого комплекса (Замоскворечье)
# По умолчанию использует основную DATABASE_URL для совместимости
ZAMOSKV_DB_URL=postgresql://user:pass@localhost:5432/domhub_zamoskv

# ── Пароль Redis ──────────────────────────────────────────────────────────────
# FIX [AUDIT]: Redis теперь требует аутентификации.
# Без пароля любой процесс в docker-сети может читать кеш отозванных токенов.
# Сгенерируйте: openssl rand -hex 24
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ── SMS.ru API ────────────────────────────────────────────────────────────────
# Зарегистрируйтесь на https://sms.ru, скопируйте API ID из настроек
# Пока не готово — оставьте STUB (коды будут видны в логах: docker compose logs backend)
SMSRU_API_ID=STUB
SENTRY_DSN=

# ── URL адреса ────────────────────────────────────────────────────────────────
# IP вашего сервера на Timeweb (или домен если есть)
BACKEND_URL=http://YOUR_SERVER_IP
FRONTEND_URL=http://YOUR_SERVER_IP

# ── Домен для nginx HTTPS конфига ─────────────────────────────────────────────
# FIX [AUDIT]: используется envsubst для подстановки в nginx CSP-заголовок.
# При HTTP: можно оставить IP сервера.
# При HTTPS: укажите реальный домен (например: residenze.yourdomain.com).
YOUR_DOMAIN=YOUR_SERVER_IP_OR_DOMAIN

# Set to true only after HTTPS certificates are issued and port 443 is enabled in docker-compose.yml.
ENABLE_HTTPS=false

# ── Push Notifications — Phase 1 ─────────────────────────────────────────────
# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Install library first: npm install web-push  (in backend/)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@zamoskv.ru

# FCM server key (optional — needed only for FCM v1 delivery)
FCM_SERVER_KEY=

# ── Telegram Bot — Phase 1 ────────────────────────────────────────────────────
# Create a bot via @BotFather, copy the token here
# One bot per property — configure per-property via the platform admin UI
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
